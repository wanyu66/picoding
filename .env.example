# Copy this file to `.env` for local development.
# The app auto-loads `.env` and `.env.local` from the repository root before Spring starts.
# `launch.sh` and `deploy.sh` will also source these files before starting the jar.

# AI providers
PAICODING_OPENAI_API_KEY=
PAICODING_ZHIPU_API_SECRET_KEY=
PAICODING_ZHIPU_CODING_API_KEY=
PAICODING_XUNFEI_APP_ID=
PAICODING_XUNFEI_API_KEY=
PAICODING_XUNFEI_API_SECRET=
PAICODING_XUNFEI_API_PASSWORD=
PAICODING_DEEPSEEK_API_KEY=
PAICODING_DOUBAO_API_KEY=
PAICODING_DOUBAO_ENDPOINT=

# Optional web search for PaiCoding AI bot replies.
# ZHI_PU_AI uses the native web_search tool; ZHIPU_CODING uses Coding Plan MCP.
PAICODING_AI_WEB_SEARCH_ENGINE=search_pro
PAICODING_AI_WEB_SEARCH_COUNT=5
PAICODING_AI_WEB_SEARCH_RECENCY=noLimit
PAICODING_AI_WEB_SEARCH_CONTENT_SIZE=high
PAICODING_AI_WEB_SEARCH_CODING_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp

# Login / auth
PAICODING_WX_APP_SECRET=

# Storage
PAICODING_OSS_AK=
PAICODING_OSS_SK=
PAICODING_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
PAICODING_OSS_BUCKET=picoding
PAICODING_OSS_HOST=https://paicoding.oss-cn-beijing.aliyuncs.com/

# Aliyun VOD. Used for browser direct upload of audio/video files.
# Requires VOD service enabled and RAM permissions such as AliyunVODUploadAuth/AliyunVODPlayAuth.
PAICODING_VOD_ENABLED=false
PAICODING_VOD_AK=
PAICODING_VOD_SK=
PAICODING_VOD_REGION_ID=cn-shanghai
PAICODING_VOD_USER_ID=paicoding
PAICODING_VOD_STORAGE_LOCATION=
PAICODING_VOD_CATE_ID=
PAICODING_VOD_TEMPLATE_GROUP_ID=
PAICODING_VOD_WORKFLOW_ID=

# Database
PAICODING_DB_PASSWORD=

# Elasticsearch
# Share PaiSmart local Elasticsearch 8.10 by setting PAICODING_ES_OPEN=true
PAICODING_ES_SEARCH_TIMEOUT_MS=1500
PAICODING_ES_SEARCH_POOL_TIMEOUT_MS=200
PAICODING_ES_SOCKET_TIMEOUT_MS=3000
PAICODING_ES_CIRCUIT_FAILURE_THRESHOLD=5
PAICODING_ES_CIRCUIT_OPEN_SECONDS=30
PAICODING_ES_SLOW_QUERY_MS=500
# and filling the same username/password.
PAICODING_ES_OPEN=true
PAICODING_ES_HOSTS=127.0.0.1:9200
PAICODING_ES_SCHEME=https
PAICODING_ES_USERNAME=elastic
PAICODING_ES_API_COMPATIBILITY_MODE=true
PAICODING_ES_INSECURE_TRUST_ALL_CERTIFICATES=true

# Docker Canal/Kibana (docker-compose.canal-kibana.yml)
# Create this least-privilege MySQL account before starting Canal; see the setup guide.
CANAL_DB_USERNAME=canal
CANAL_DB_PASSWORD=canal
CANAL_FILTER_REGEX=pai_coding\..*
CANAL_PORT=11111
CANAL_ADAPTER_PORT=8081
CANAL_ADAPTER_JAVA_OPTS=-Xms256m -Xmx512m
CANAL_ES_HOSTS=http://host.docker.internal:9200
KIBANA_PORT=5601
KIBANA_ELASTICSEARCH_HOSTS=http://host.docker.internal:9200

# Optional local Elasticsearch process settings for ./start-elasticsearch.sh
ES_HOME=/Users/itwanger/Downloads/elasticsearch-8.10.0
ES_HTTP_PORT=9200
ES_TRANSPORT_PORT=9300
ES_JAVA_OPTS="-Xms500M -Xmx500M"

# Optional aliases for standalone tools/tests
OPENAI_API_KEY=

# Unified LLM routing and user safeguards
# Supported routed providers: zhipu, doubao. Leave CHAT provider empty to preserve automatic selection.
PAICODING_LLM_TIMEOUT_MS=10000
PAICODING_LLM_MAX_RETRIES=1
PAICODING_LLM_CIRCUIT_FAILURES=3
PAICODING_LLM_CIRCUIT_OPEN_SECONDS=30
PAICODING_LLM_PER_MINUTE=10
PAICODING_LLM_MAX_CONCURRENT=2
PAICODING_LLM_DAILY_QUOTA=100
PAICODING_LLM_ABNORMAL_DAILY_USAGE=80
PAICODING_LLM_CHAT_PROVIDER=
PAICODING_LLM_CHAT_MODEL=
PAICODING_LLM_CHAT_FALLBACK_PROVIDER=
PAICODING_LLM_CHAT_FALLBACK_MODEL=
PAICODING_LLM_SEO_PROVIDER=zhipu
PAICODING_LLM_SEO_MODEL=glm-4-air-0111
PAICODING_LLM_SEO_FALLBACK_PROVIDER=doubao
PAICODING_LLM_SUMMARY_PROVIDER=doubao
PAICODING_LLM_SUMMARY_FALLBACK_PROVIDER=zhipu
PAICODING_LLM_MODERATION_PROVIDER=zhipu
PAICODING_LLM_MODERATION_FALLBACK_PROVIDER=doubao
# Configure current provider prices per one million tokens to enable non-zero cost estimates.
PAICODING_LLM_CHAT_INPUT_COST=0
PAICODING_LLM_CHAT_OUTPUT_COST=0
PAICODING_LLM_SEO_INPUT_COST=0
PAICODING_LLM_SEO_OUTPUT_COST=0
PAICODING_LLM_SUMMARY_INPUT_COST=0
PAICODING_LLM_SUMMARY_OUTPUT_COST=0
PAICODING_LLM_MODERATION_INPUT_COST=0
PAICODING_LLM_MODERATION_OUTPUT_COST=0

# WebSocket streaming protocol, replay, backpressure and optional multi-node STOMP relay
# Leave allowed origins empty to use Spring's same-origin policy.
PAICODING_CHAT_WS_ALLOWED_ORIGINS=
PAICODING_CHAT_WS_MAX_CONNECTIONS=3
PAICODING_CHAT_WS_AUTH_MAX_AGE_SECONDS=1800
PAICODING_CHAT_WS_SEND_TIME_LIMIT_MS=10000
PAICODING_CHAT_WS_SEND_BUFFER_BYTES=524288
PAICODING_CHAT_WS_MESSAGE_SIZE_BYTES=65536
PAICODING_CHAT_WS_OUTBOUND_QUEUE_CAPACITY=256
PAICODING_CHAT_WS_REPLAY_MAX_EVENTS=200
PAICODING_CHAT_WS_GENERATION_BUFFER_BYTES=524288
PAICODING_CHAT_WS_REPLAY_TTL_SECONDS=900
PAICODING_CHAT_WS_MODEL_TIMEOUT_MS=120000
PAICODING_CHAT_WS_BROKER_RELAY_ENABLED=false
PAICODING_CHAT_WS_BROKER_HOST=127.0.0.1
PAICODING_CHAT_WS_BROKER_PORT=61613
PAICODING_CHAT_WS_BROKER_LOGIN=guest
PAICODING_CHAT_WS_BROKER_PASSCODE=guest

# Conversation context trimming and deterministic summary compression
PAICODING_CHAT_CONTEXT_MAX_INPUT_TOKENS=3000
PAICODING_CHAT_CONTEXT_RESERVE_OUTPUT_TOKENS=800
PAICODING_CHAT_CONTEXT_SUMMARY_MAX_CHARS=600
PAICODING_CHAT_CONTEXT_MAX_MESSAGE_CHARS=4000
