{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "articleId": { "type": "long" },
      "authorId": { "type": "long" },
      "articleType": { "type": "integer" },
      "title": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart",
        "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
      },
      "shortTitle": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart",
        "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
      },
      "urlSlug": { "type": "keyword", "ignore_above": 256 },
      "picture": { "type": "keyword", "ignore_above": 2048 },
      "summary": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
      "categoryId": { "type": "long" },
      "source": { "type": "integer" },
      "sourceUrl": { "type": "keyword", "ignore_above": 2048 },
      "officalStat": { "type": "integer" },
      "toppingStat": { "type": "integer" },
      "creamStat": { "type": "integer" },
      "status": { "type": "integer" },
      "deleted": { "type": "integer" },
      "createTime": { "type": "date", "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis" },
      "updateTime": { "type": "date", "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis" }
    }
  }
}

